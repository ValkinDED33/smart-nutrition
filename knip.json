{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/App.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.mjs",
    "*.config.{js,ts}",
    "vite-env.d.ts"
  ],
  "ignoreFiles": [
    "server/services/aiProvider.mjs",
    "src/assistant/engine/assistantEngine.ts",
    "src/assistant/engine/assistantRules.ts",
    "src/assistant/engine/assistantRuntimeFacade.ts",
    "src/assistant/engine/assistantTypes.ts",
    "src/assistant/state/assistantStore.ts",
    "src/data/index.ts",
    "src/data/products/index.ts",
    "src/data/profile/index.ts",
    "src/data/shared/index.ts",
    "src/domain/index.ts",
    "src/domain/products/index.ts",
    "src/domain/profile/index.ts",
    "src/domain/shared/index.ts",
    "src/domain/types/appSnapshot.ts",
    "src/features/assistant/index.ts",
    "src/features/assistant/model/assistantStore.ts",
    "src/features/auth/index.ts",
    "src/features/index.ts",
    "src/features/meal/DailyMicronutrientsCard.tsx",
    "src/features/meal/hooks/index.ts",
    "src/features/meal/hooks/useMealOperations.ts",
    "src/features/meal/index.ts",
    "src/features/meal/usecases/index.ts",
    "src/features/products/index.ts",
    "src/features/profile/AdaptiveGoalCard.tsx",
    "src/features/profile/index.ts",
    "src/integration/index.ts",
    "src/integration/runtime/index.ts",
    "src/integration/shared/errors.ts",
    "src/integration/shared/index.ts",
    "src/pages/WaterPage.tsx",
    "src/shared/types/rawProduct.ts",
    "src/state/companion/index.ts",
    "src/state/index.ts",
    "src/state/meal/index.ts",
    "src/state/products/index.ts",
    "src/state/profile/index.ts",
    "src/state/sync/index.ts",
    "src/widgets/ContextAssistantWidget.tsx",
    "vite-env.d.ts"
  ],
  "ignoreDependencies": [
    "@types/react-redux",
    "prettier"
  ],
  "ignoreIssues": {
    "server/**/*.mjs": ["exports", "types"],
    "src/**/*.ts": ["exports", "types", "duplicates"],
    "src/**/*.tsx": ["exports", "types", "duplicates"]
  }
}
