{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/App.tsx"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "server/**/*.mjs",
    "*.config.{js,ts}",
    "vite-env.d.ts"
  ],
  "ignoreFiles": [
    "vite-env.d.ts"
  ],
  "ignoreIssues": {
    "server/**/*.mjs": ["exports", "types"],
    "src/**/*.ts": ["exports", "types", "duplicates"],
    "src/**/*.tsx": ["exports", "types", "duplicates"]
  }
}
