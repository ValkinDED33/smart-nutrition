NODE_ENV=development
SMART_NUTRITION_API_PORT=8787
SMART_NUTRITION_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SMART_NUTRITION_ACCESS_TTL_MS=900000
SMART_NUTRITION_REFRESH_TTL_MS=604800000
SMART_NUTRITION_PASSWORD_ITERATIONS=180000
SMART_NUTRITION_BODY_LIMIT_BYTES=5242880
SMART_NUTRITION_BACKUP_INTERVAL_MS=600000
SMART_NUTRITION_MAX_BACKUPS=24
SMART_NUTRITION_RATE_LIMIT_WINDOW_MS=60000
SMART_NUTRITION_RATE_LIMIT_MAX=180
SMART_NUTRITION_SERVE_STATIC=true
SMART_NUTRITION_STATIC_DIR=dist

# Durable production storage. Leave empty to infer SQLite/PostgreSQL/MongoDB from configured URLs.
SMART_NUTRITION_DATABASE_PROVIDER=
SMART_NUTRITION_DATABASE_URL=
SMART_NUTRITION_DATABASE_SSL=false
SMART_NUTRITION_DB_PATH=server/data/smart-nutrition.sqlite
SMART_NUTRITION_BACKUP_DIR=server/data/backups
SMART_NUTRITION_SECRET_FILE_DIR=/etc/secrets

# Optional Redis cache/distributed rate limiting.
SMART_NUTRITION_REDIS_URL=
SMART_NUTRITION_REDIS_KEY_PREFIX=smart-nutrition
SMART_NUTRITION_REDIS_CONNECT_TIMEOUT_MS=5000
SMART_NUTRITION_CATALOG_CACHE_TTL_SECONDS=60

# Frontend builds must point to a reachable API base URL.
# Local Vite can also use the /api proxy, but deployed Vercel builds need a public backend URL.
VITE_SMART_NUTRITION_API_BASE_URL=

# Optional browser runtime integrations. Leave empty to keep SDKs disabled.
VITE_ELEVENLABS_API_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Backend CORS must include the deployed frontend origin when frontend and API are on different domains.
SMART_NUTRITION_APP_BASE_URL=http://localhost:5173
SMART_NUTRITION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMART_NUTRITION_AUTH_COOKIE_SAME_SITE=Lax
SMART_NUTRITION_AUTH_COOKIE_SECURE=false
# Optional production seed. The first registered account with this email becomes SUPER_ADMIN.
SMART_NUTRITION_SUPER_ADMIN_EMAIL=

# Required for production password reset emails.
SMART_NUTRITION_SMTP_URL=
SMART_NUTRITION_SMTP_HOST=
SMART_NUTRITION_SMTP_PORT=587
SMART_NUTRITION_SMTP_SECURE=false
SMART_NUTRITION_SMTP_USER=
SMART_NUTRITION_SMTP_PASS=
SMART_NUTRITION_EMAIL_FROM=
SMART_NUTRITION_EMAIL_FROM_NAME=Smart Nutrition

# Backend SMS delivery for registration codes via MANGO OFFICE.
# Secret-file deployments can create files with these exact names in SMART_NUTRITION_SECRET_FILE_DIR.
SMART_NUTRITION_MANGO_API_KEY=
SMART_NUTRITION_MANGO_API_SALT=
SMART_NUTRITION_MANGO_FROM_EXTENSION=101
SMART_NUTRITION_MANGO_SMS_SENDER=
SMART_NUTRITION_MANGO_SMS_ENDPOINT=https://app.mango-office.ru/vpbx/commands/sms
SMART_NUTRITION_MANGO_SMS_TIMEOUT_MS=10000

# AI assistant providers. Set at least one provider key + model to enable cloud AI.
SMART_NUTRITION_ASSISTANT_API_KEY=
SMART_NUTRITION_ASSISTANT_MODEL=
SMART_NUTRITION_ASSISTANT_PROVIDER=
SMART_NUTRITION_ASSISTANT_BASE_URL=https://api.openai.com/v1
SMART_NUTRITION_ASSISTANT_API_PATH=/chat/completions
SMART_NUTRITION_ASSISTANT_PROVIDER_ORDER=openrouter,groq,google
SMART_NUTRITION_ASSISTANT_TEMPERATURE=0.4
SMART_NUTRITION_ASSISTANT_MEMORY_LIMIT=16
SMART_NUTRITION_ASSISTANT_TIMEOUT_MS=20000
SMART_NUTRITION_ASSISTANT_RETRY_COOLDOWN_MS=300000
SMART_NUTRITION_AI_RATE_LIMIT_WINDOW_MS=60000
SMART_NUTRITION_AI_RATE_LIMIT_MAX=20
SMART_NUTRITION_AI_DAILY_REQUEST_LIMIT=40
SMART_NUTRITION_AI_MONTHLY_REQUEST_LIMIT=600
SMART_NUTRITION_AI_DAILY_TOKEN_LIMIT=60000
SMART_NUTRITION_AI_MONTHLY_TOKEN_LIMIT=800000
SMART_NUTRITION_AI_REQUEST_COOLDOWN_MS=6000
SMART_NUTRITION_AI_ESTIMATED_USD_PER_1K_TOKENS=0.002

# Optional MongoDB Atlas storage. With DATABASE_PROVIDER empty, SMART_NUTRITION_MONGO_URI
# becomes the main backend storage and also enables the MongoDB AI data provider.
SMART_NUTRITION_MONGO_URI=
# Optional override. If empty, the database name is read from the URI path, then smart_nutrition.
SMART_NUTRITION_MONGODB_DB=
SMART_NUTRITION_MONGODB_TIMEOUT_MS=5000
SMART_NUTRITION_MONGODB_CONNECT_RETRIES=3
SMART_NUTRITION_MONGODB_CONNECT_RETRY_DELAY_MS=1000
SMART_NUTRITION_MONGODB_CONNECT_TIMEOUT_MS=10000
SMART_NUTRITION_MONGODB_SOCKET_TIMEOUT_MS=45000
SMART_NUTRITION_MONGODB_MIN_POOL_SIZE=0
SMART_NUTRITION_MONGODB_MAX_POOL_SIZE=20

SMART_NUTRITION_OPENROUTER_API_KEY=
SMART_NUTRITION_OPENROUTER_MODEL=
SMART_NUTRITION_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SMART_NUTRITION_OPENROUTER_TIMEOUT_MS=20000
SMART_NUTRITION_OPENROUTER_HTTP_REFERER=http://localhost:5173
SMART_NUTRITION_OPENROUTER_TITLE=Smart Nutrition

SMART_NUTRITION_GROQ_API_KEY=
SMART_NUTRITION_GROQ_MODEL=
SMART_NUTRITION_GROQ_BASE_URL=https://api.groq.com/openai/v1
SMART_NUTRITION_GROQ_TIMEOUT_MS=20000

SMART_NUTRITION_GOOGLE_API_KEY=
SMART_NUTRITION_GOOGLE_MODEL=
SMART_NUTRITION_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SMART_NUTRITION_GOOGLE_TIMEOUT_MS=20000
